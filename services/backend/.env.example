# Set these via `supabase secrets set --env-file .env` (do NOT commit the
# real .env — only this .example file is tracked).

GEMINI_API_KEY=<your-gemini-api-key>
WEATHERAPI_KEY=<your-weatherapi-key>

# SUPABASE_URL and SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are
# injected automatically into Edge Functions by the Supabase runtime when
# deployed — you do not need to set these yourself for hosted deployments.
# For local `supabase functions serve`, the CLI injects them from your
# local stack automatically as well.
